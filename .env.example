# Variables privadas de servidor - NO uses prefijo NEXT_PUBLIC_
# Estas variables solo estan disponibles en el servidor (Route Handlers / Server Components)
# Nunca se exponen al cliente

# Numero de telefono destino para CallMeBot (formato internacional sin + ni espacios, ej: 5358816764)
CALLMEBOT_PHONE=

# API Key obtenida de CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_API_KEY=
